---
import Base from "../../../layouts/Base.astro";
import Blocks from "../../../components/Blocks.astro";
import { facts } from "../../../../content/facts";
import { getCopy } from "../../../../content";
import { locales, localePath, type Locale } from "../../../lib/locales";
import { formatIsoDate, readingMinutes } from "../../../lib/dates";
import { minutesLabel, postPlainText } from "../../../lib/format";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    getCopy(lang).insights.posts.map((post) => ({
      params: { lang, slug: post.slug },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const copy = getCopy(lang);
const post = copy.insights.posts.find((item) => item.slug === slug);
if (!post) {
  throw new Error(`Missing insight ${lang}/${slug}`);
}
const brand = lang === "he" ? facts.nameHe : facts.name;
const others = copy.insights.posts.filter((item) => item.slug !== slug);
const minutes = readingMinutes(postPlainText(post));
---

<Base
  lang={lang}
  title={`${post.title} — ${brand}`}
  description={post.description}
  path={`/insights/${post.slug}`}
  section="insights"
  ogType="article"
>
  <article class="prose-page wrap">
    <p class="kicker">
      <a href={localePath(lang, "/insights")}>{copy.ui.allNotes}</a>
    </p>
    <h1>{post.title}</h1>
    <p class="meta-line">
      <time datetime={facts.published}>{formatIsoDate(facts.published, lang)}</time>
      {" · "}
      {minutesLabel(lang, minutes)}
    </p>
    <Blocks blocks={post.blocks} />
    <p class="standnote">{copy.insights.disclaimer}</p>
    <aside class="note-index" aria-labelledby="other-notes">
      <h2 class="block-title" id="other-notes">{copy.ui.otherNotes}</h2>
      <ol class="index-list flat">
        {
          others.map((item) => (
            <li>
              <div>
                <h3>
                  <a href={localePath(lang, `/insights/${item.slug}`)}>{item.title}</a>
                </h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </aside>
  </article>
</Base>
